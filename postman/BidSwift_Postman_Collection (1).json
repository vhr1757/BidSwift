{
  "info": {
    "name": "BidSwift API \u2013 Complete Test Collection",
    "description": "Complete Postman collection covering every request currently defined in the BidSwift backend route files. Base URL defaults to http://localhost:3000. Protected requests use the accessToken collection variable. This collection contains placeholders and test credentials only; replace emails/passwords as needed for your local database.\n\nSuggested core-flow order: register/login buyer and seller \u2192 create/fund buyer wallet \u2192 create seller item \u2192 create/login auctioneer \u2192 create auction and set it active \u2192 login buyer \u2192 place bid \u2192 move auction end_time into the past \u2192 complete auction. Admin-only bill requests require an admin account/token. Some CRUD endpoints are intentionally unprotected because that is how the current backend route files are defined.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "buyerToken",
      "value": ""
    },
    {
      "key": "sellerToken",
      "value": ""
    },
    {
      "key": "auctioneerToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "buyerId",
      "value": ""
    },
    {
      "key": "sellerId",
      "value": ""
