      "item": [
        {
          "name": "Register Buyer Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Postman\",\n  \"last_name\": \"Buyer\",\n  \"email\": \"postman.buyer@example.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"buyer\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { const j=pm.response.json(); pm.collectionVariables.set('buyerId', j.user.id); }"
                ]
